; Settings for the Crash bridge (xinput9_1_0.dll). Copy to crashspyro.ini in
; the folder CrashBandicootNSaneTrilogy.exe is in; tools\install.ps1 does it.
; The bridge re-reads this file whenever it is saved, while the game runs.

[bridge]
; There is no launcher yet. Without this the bridge does nothing at all,
; which is what it should do when Crash is being played by itself.
without_launcher = 1

[debug]
; A line in crashspyro_crash.log this often saying what the bridge can see,
; as well as whenever that changes. 0 = only when it changes.
status_seconds = 10
; Experiments from docs/PHASE1.md. Each acts when its text is changed and
; the file saved, with Crash on foot in a level:
;   fence = 1   nine still copies of his capsule in a row ahead of him
;   slab = 1    a box to stand on (slab_top, slab_ahead, slab_half, slab_thick: metres)
;   mesh = 1    a ramp of triangles (mesh_rise, mesh_run: metres)
;   clear = 1   takes out everything the three above put in
; From docs/PHASE2.md:
;   camera_test = 1            the camera swings round Crash (0 stops it)
;   watch_camera = 0x180 4 #1  logs what code writes there in the camera
;                              object over the next three seconds
; and press = LS_UP 400 #1 has the bridge hold the stick or a button itself
; (LS:0.5,-0.87 for a stick held anywhere: across, then up, each -1 to 1).

[start]
; 1 = go from the title screen to the Crash 3 hub with the save in use, with
; nobody at the controller: the bridge presses A at the title, then right,
; right and A on "Continue" under Crash Warped. The opening videos still
; play. Read when the game starts.
auto_load = 0

[pad]
; 1 = Crash hears the controller only while its window is the one in front,
; or while Spyro's character is following Crash (then the controller is
; Crash's whichever window is in front). 0 = always, as the game does by
; itself.
only_in_front = 1

[ground]
; While Spyro sends its ground, which way "up" on the stick takes Crash:
; 1 = away from the player in Spyro's picture: the direction Crash's game
; steers by is turned to Spyro's camera (docs/PHASE2.md, "Steering by
; Spyro's camera"). 2 = the same aim by turning the stick, which is only
; right at some angles; kept to compare. 0 = as Crash's own camera has it.
steer_by_spyro = 1
; What of Crash's own level is taken out of his physics meanwhile, and put
; back afterwards: 2 = everything of it that stands still (ground, walls,
; crates), 1 = only its ground and walls, 0 = nothing.
hide_own_level = 2

[view]
; 1 = while Spyro's ground is in, Crash's game draws through Spyro's camera
; (docs/PHASE2.md). 0 = through its own.
by_spyro = 1

[picture]
; 1 = each frame Crash's game draws is sent, with how far away each part of
; it is, for Spyro to mix into its own (docs/PHASE2.md). 0 = none is sent.
send = 1
; Which of the scene-sized depth buffers the game clears in a frame holds
; the scene, counting from 0.
depth_pick = 0
; 1 = while Crash is on Spyro's ground his frames are shown as they come,
; without waiting for the screen: waiting makes about every fourteenth late,
; and Spyro's character stumbles with it (docs/PHASE2.md, "Moving evenly").
; 0 = as the game asks.
no_wait = 1

[window]
; 1 = while Crash is drawn in Spyro's picture his own window is hidden, and
; comes back when he is not. 0 = it stays where it is.
hide = 0

[places]
; Where things are in the one build of the exe the mod knows (see
; docs/PHASE0.md). The values built in are used unless one is given here,
; e.g. while hunting for something that has moved:
; actorList = 0x1A9E778
