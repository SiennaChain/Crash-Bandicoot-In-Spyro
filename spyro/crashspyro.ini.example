; Settings for the Spyro bridge (xinput1_3.dll). Copy to crashspyro.ini in
; Falcon\Binaries\Win64, beside Spyro-Win64-Shipping.exe; tools\install.ps1
; does it. The bridge re-reads this file whenever it is saved, while the game
; runs.

[bridge]
; There is no launcher yet. Without this the bridge does nothing at all,
; which is what it should do when Spyro is being played by itself.
without_launcher = 1

[debug]
; A line in crashspyro_spyro.log this often saying what the bridge can see,
; as well as whenever that changes. 0 = only when it changes.
status_seconds = 10
; ground = 1 (any change of the text): writes the collision that would be
; sent to crashspyro_ground.bin beside the exe, and logs how far the ground
; is under the pawn.

[start]
; 1 = press the controller's A for the player from the title screen until the
; game is in a level, which takes "Continue": the save played last. For
; restarting the game while working on the mod without touching it. Read when
; the game starts.
auto_continue = 0

[pad]
; 1 = Spyro hears the controller only while its window is the one in front
; (a controller, unlike keys, reaches every game that is running). While
; Spyro's character is following Crash it hears only the camera stick and
; Start/Back whichever window is in front; this setting does not change that.
only_in_front = 1

[follow]
; Following: Spyro's character is put where Crash is, every frame, and
; Spyro's own movement is switched off meanwhile. Pressing `key` (a Windows
; virtual-key number; 0x71 is F2) switches it on and off, and so does
; changing `on` here and saving. Once on it stays asked for: it begins when
; Crash is standing still in a level and Spyro is standing in one, and
; begins again by itself after Spyro changes level.
on = 0
key = 0x71
; 1 = Spyro's ground goes to Crash to stand on, and the two worlds are laid
; over each other exactly, joined where each character was standing when
; following began (docs/PHASE1.md). 0 = the Phase 0 test below: Crash stays
; on his own level's ground and only his steps are copied.
ground = 1
; Unreal units moved per Crash unit moved. 0.5 is measured: at that, Crash
; runs as fast as Spyro and his jump is as high as Spyro's.
scale = 0.5
; With ground: Spyro's character is put where Crash was this many
; thousandths of a second ago, between two of his frames, which is what
; makes it move evenly (docs/PHASE2.md, "Moving evenly"). Less answers the
; stick sooner and stumbles when a frame of his is late; 30 never stumbles.
behind_ms = 20
; The rest is for ground = 0.
; 1 = each step Crash takes is turned from his camera to Spyro's, so "away
; from the player" is away from the player in both games wherever the
; cameras point. 0 = Crash's world laid over Spyro's with one fixed turn
; (yaw, in degrees about up, and flip_y for its y axis running the other
; way), which is right for one direction of Spyro's camera only.
relative = 1
yaw = 0
flip_y = 1
; Following lets go, and puts Spyro back where it began, if Crash gets this
; many of his own units from where it began (he died, or ran a long way).
reach = 6000

[ground]
; How much of Spyro's collision is sent: this far from the pawn each way
; along the ground, and this far above and below it, in Unreal units. It is
; read again when the pawn has gone 0.4 of the reach from the last time.
reach = 6000
up = 3000
down = 3000
; 0 = the collision the engine moves its own characters against (simple).
; 1 = the detailed collision of every mesh instead: many more triangles.
complex = 0

[picture]
; 1 = while Crash is on Spyro's ground he is drawn into Spyro's picture
; (docs/PHASE2.md), and (hide_spyro) Spyro's own character is not drawn.
show = 1
hide_spyro = 1
; 1 = the whole of what arrives from Crash, small, in a corner.
corner = 0
; The near plane Spyro's engine draws with, and how much nearer than Crash
; Spyro's scene must be to hide him, in Unreal's units.
near = 5
bias = 2
; How dark the shadow under Crash is: 0 = none, 1 = black.
shadow = 0.45
; 1 = his picture is moved to where the camera of the frame being shown
; would see him. 0 = drawn where Crash's game drew it, a frame or two ago.
steady = 1
; How big he is drawn, about his feet: 1 = as Crash's game drew him, 0.5 =
; half. Only how he looks: his run, his jump and what stops him are as they
; were (docs/PHASE2.md, "He is big"). At 0.9 he comes up to just below
; Hunter's shoulder.
size = 0.9

[places]
; Where things are in the one build of the exe the mod knows (see
; docs/PHASE0.md). The values built in are used unless one is given here,
; e.g. while hunting for something that has moved:
; world = 0x3415F30
